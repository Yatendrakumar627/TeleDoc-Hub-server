# ==========================================
# TeleDoc Hub - Server Environment Variables
# ==========================================

# Port for the Node.js Express server
PORT=5000

# Telegram Private Channel Storage Credentials
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_private_channel_chat_id_here

# MongoDB Atlas or Local Database Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/teledoc_vault?retryWrites=true&w=majority

# Zero-Knowledge AES-256-GCM Vault Master Key (64-character hex string)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET_KEY=your_64_hex_character_encryption_key_here

# JSON Web Token Secret for Multi-Tenant Auth Sessions
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# JWT Expiration Duration (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d

# Optional: ID of pinned message if using Telegram Channel Index
INDEX_MESSAGE_ID=

